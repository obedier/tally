{
  "version": "1.0.0",
  "description": "Golden-query seeds for the eval harness. Each case lists graded expected properties per docs/LEARNING.md: category inference, query type, sensible assumptions, source diversity, verdict clarity, honest uncertainty. The runner (evals/run.ts) validates the report contract (S3) and grades these expectations (S4/S5).",
  "cases": [
    {
      "id": "ce-named-01",
      "query": "Sony WH-1000XM5",
      "mode": "quick",
      "expect": {
        "category": "consumer-electronics",
        "queryType": "named-product",
        "verdictStyle": "named-product-verdict",
        "minSources": 8,
        "minSourceClasses": 3,
        "assumptionHints": ["noise", "travel", "commut", "music", "call", "budget", "wireless", "comfort"]
      }
    },
    {
      "id": "ce-named-02",
      "query": "MacBook Air M4 13 inch",
      "mode": "full",
      "expect": {
        "category": "consumer-electronics",
        "queryType": "named-product",
        "verdictStyle": "named-product-verdict",
        "minSources": 8,
        "minSourceClasses": 3,
        "assumptionHints": ["battery", "portab", "budget", "work", "student", "performance", "memory", "storage"]
      }
    },
    {
      "id": "ce-need-01",
      "query": "best budget 27 inch monitor for working from home",
      "mode": "full",
      "expect": {
        "category": "consumer-electronics",
        "queryType": "need",
