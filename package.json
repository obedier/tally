{
  "name": "tally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --port 5200 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "tsx evals/run.ts",
    "mine": "tsx scripts/run-mining.ts",
    "digest": "tsx scripts/run-digest.ts",
    "build:native": "tsc --noEmit && VITE_PUBLIC_ORIGIN=https://tally.o11r.com vite build --outDir dist/native",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/playfair-display": "^5.2.5",
    "@hono/node-server": "^1.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.7",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  }
}
